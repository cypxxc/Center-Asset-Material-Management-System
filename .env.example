# Copy to .env.local and fill in the PostgreSQL connection values.
# Application runtime role (camms_app):
DATABASE_URL=postgres://camms_app:<PASSWORD>@127.0.0.1:15432/camms_registry
# Authentication verification role (camms_auth):
DATABASE_AUTH_URL=postgres://camms_auth:<PASSWORD>@127.0.0.1:15432/camms_registry
# Local storage path for uploaded assets & documents:
LOCAL_STORAGE_PATH=./.local-storage

# Migration / Database Owner role (used only for running migrations via drizzle-kit / setup scripts)
DATABASE_MIGRATION_URL=postgres://postgres:<PASSWORD>@127.0.0.1:15432/camms_registry

# Optional integrations
GEMINI_API_KEY=
