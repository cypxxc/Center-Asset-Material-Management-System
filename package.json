{
  "name": "omni-asset",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.14.1",
  "scripts": {
    "postgres:setup": "tsx scripts/postgres-local.ts setup",
    "postgres:up": "tsx scripts/postgres-local.ts up",
    "postgres:stop": "tsx scripts/postgres-local.ts stop",
    "postgres:test": "tsx scripts/postgres-local.ts test",
    "postgres:app:setup": "tsx scripts/postgres-app.ts setup",
    "postgres:activate": "tsx scripts/postgres-app.ts activate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "next dev --webpack",
    "build": "next build --webpack && tsx scripts/check-bundle-budget.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check": "npm run verify-env && npm test && npm run lint && npm run build",
    "test": "tsx scripts/run-tests.ts",
    "test:coverage": "tsx scripts/run-tests.ts --coverage",
    "test:smoke": "npm run build && tsx scripts/run-playwright.ts smoke",
    "test:e2e": "npm run build && tsx scripts/run-playwright.ts chromium",
    "test:e2e:release": "tsx scripts/release-e2e.ts",
    "test:all": "npm run check && npm run test:smoke",
    "verify-env": "tsx scripts/verify-env.ts",
    "verify-db-release": "tsx scripts/verify-database-readiness.ts",
    "backup:release": "tsx scripts/backup.ts",
    "postgres:verify:security": "node --conditions=react-server --import tsx scripts/verify-postgres-security.ts",
    "postgres:verify:browser": "tsx scripts/verify-postgres-browser.ts",
    "postgres:verify:http": "tsx scripts/verify-postgres-http.ts",
    "postgres:verify:limits": "tsx scripts/verify-postgres-limits.ts",
    "postgres:verify:recovery": "tsx scripts/verify-postgres-recovery.ts",
    "postgres:verify:load": "tsx scripts/verify-postgres-load.ts",
    "postgres:production:prepare": "tsx scripts/prepare-production.ts",
    "postgres:backup:job": "tsx scripts/postgres-backup-job.ts",
    "audit:release": "npm audit --omit=dev --audit-level=high",
    "audit:security": "tsx scripts/verify-security.ts",
    "mcp": "tsx scripts/mcp-server.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.25.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "radix-ui": "^1.6.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "glob": "^13.0.6",
    "jsdom": "^29.1.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": { "esbuild": "0.25.12" },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "nanoid": "^3.3.18",
    "postcss": "^8.5.19",
    "sharp": "^0.35.0"
  }
}
