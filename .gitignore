# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing artifacts
/coverage
/test-results/
/playwright-report/
/blob-report/
.nyc_output/
/playwright/.cache/

# database migrations
# Only track SQL files and meta json/journal required by Drizzle
/db/postgres/migrations/*
!/db/postgres/migrations/*.sql
!/db/postgres/migrations/meta/
/db/postgres/migrations/meta/*
!/db/postgres/migrations/meta/_journal.json
!/db/postgres/migrations/meta/*.json

# next.js
/.next/
/out/

# production
/build
/backups/

# misc
.DS_Store
Thumbs.db
*.pem
*.tmp
*.temp
*.bak
*.swp
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log
*.log
*.log.*
.*.log
*.pid
*.pid.lock

# editor & ide
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# local workspace / agent logs & skills
.agent/
.agents/
skills-lock.json
.worktrees/
.superpowers/
.next-dev.log
.next-dev.err.log
/.cache/
/.local-storage/
/.turbo/
desktop.ini

# temporary scratch
scratch/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Supabase CLI local state
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# documents & spreadsheets
*.xlsx
*.xls
*.csv
/docs/*.xlsx
/docs/*.xls
/docs/*.csv
