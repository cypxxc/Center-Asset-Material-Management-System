# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
tests/e2e/staging/.auth/
tests/e2e/staging/downloads/
tests/e2e/staging/screenshots/
tests/e2e/staging/results.json

# next.js
/.next/
/out/

# production
/build
/backups/

# misc
.DS_Store
Thumbs.db
*.pem
*.tmp
*.swp
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log
*.log

# editor & ide
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# local workspace / agent logs & skills
.agent/
.agents/
skills-lock.json
.worktrees/
.superpowers/
.next-dev.log
.next-dev.err.log
/.cache/
/.local-storage/
/.turbo/
desktop.ini

# temporary scratch & draft files
scratch/
*.md
!README.md
!readme.md
!**/README.md
!**/readme.md
!docs/context/PRODUCT.md
!docs/superpowers/plans/*.md
!docs/superpowers/specs/*.md
!docs/production/2026-10-14-production-readiness-capriola.md
!/AGENTS.md


# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Supabase CLI local state
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# backend php / composer
/backend/vendor/
/backend/node_modules/
/backend/storage/*.key
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/bootstrap/cache/*
!/backend/storage/framework/cache/.gitignore
!/backend/storage/framework/sessions/.gitignore
!/backend/storage/framework/views/.gitignore
!/backend/storage/logs/.gitignore
!/backend/bootstrap/cache/.gitignore
