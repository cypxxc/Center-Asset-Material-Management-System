.agent/
.worktrees/
.superpowers/
.next-dev.log
.next-dev.err.log
/.cache/
/.turbo/
desktop.ini

# temporary scratch & draft files
scratch/
*.scratch.md
*.tmp.md


# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
